{
  "name": "@dexcalibur/dexcalibur-agent",
  "version": "1.3.4",
  "description": "The dexcalibur agent-side lib",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npx tsc",
    "pack-generic": "npx webpack --config webpack.android.config.js",
    "pack-x64": "npx webpack --config webpack.android.x64.config.js",
    "pack-arm64": "npx webpack --config webpack.android.arm64.config.js",
    "cleanup": "rm -r ./dist"
  },
