    "@reversenseorg:registry": "https://npm.pkg.github.com/"
  },
  "devDependencies": {
    "@types/frida-gum": "^17.3.0",
    "@types/node": "^17.0.10",
    "frida-java-bridge": "^7.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^4.5.4",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@reversense/interruptor": "^1.0.6"
