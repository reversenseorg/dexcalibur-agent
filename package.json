{
  "name": "@dexcalibur/dexcalibur-agent",
  "version": "1.1.0",
  "description": "The dexcalibur agent-side lib",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npx tsc",
    "pack-generic": "npx webpack --config webpack.android.config.js",
    "pack-x64": "npx webpack --config webpack.android.x64.config.js",
    "pack-arm64": "npx webpack --config webpack.android.arm64.config.js",
    "cleanup": "rm -r ./dist"
  },
  "files": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "*.d.ts",
    "*.js"
  ],
  "repository": {
    "type": "git",
    "url": "git@gitlab.reversense.org:dexcalibur/dexcalibur-agent.git"
  },
  "publishConfig": {
    "@dexcalibur:registry": "https://gitlab.reversense.org/api/v4/projects/4/packages/npm/"
  },
  "keywords": [
    "frida",
    "strace",
    "syscall",
    "hook",
    "drcov",
    "coverage"
  ],
  "author": "Georges-Bastien Michel <georges@reversense.com>",
  "license": "Copyright",
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/frida-gum": "^17.3.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^17.0.10",
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.5.4",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@reversense/interruptor": "^1.0.6",
    "frida-java-bridge": "7.0.3"
  },
  "type": "module"
}
