{
  "compilerOptions": {
    "lib": ["es2017"],
    "target": "es2020", // es2017
    "module": "ES2020",
    "declaration": true,
    "outDir": "./distScript",
    "removeComments": true,
    "sourceMap": true,
    "typeRoots": [
      "../node_modules/@types"
    ],
